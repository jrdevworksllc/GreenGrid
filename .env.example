# Copy frontend values into frontend-web/.env.local.
# Set backend values in the environment before starting the API.
# Leave secrets empty here. Do not commit real keys.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Optional. When unset, design previews use the mock provider.
DESIGN_API_KEY=
